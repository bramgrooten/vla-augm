__pycache__
.vscode
*.log
*.idx
*.npy
*.txt
!requirements/**
!docs/*
*.DS_Store
*.out
build
docs/build
dist
logs/*
outputs/*
*.so
.venv
.docs-venv
uv.lock
rlinf/envs/maniskill/assets
examples/logs/
models/
PKG-INFO
*.egg-info/
.claude/settings.json
# Overlay banks for augmentation (large binary .pt, e.g. 26 GB ImageNet-21k bank)
overlay_banks/
MUJOCO_LOG.TXT
.venv-pi/
venv-pi/
# Every venv, whatever it is suffixed with (.venv-gr00t, .venv-so101, ...).
# The bare `.venv` above matches only that exact name, so each new venv was one
# `git add -A` away from staging ~100k files.
.venv*/
venv-*/

# RL checkpoints for the augmentation grid (tens of GB per arm)
ckpts/

# wandb local run files written by vla_augm/utils/upload_ood_to_wandb.py when run
# from the repo root; the real records live in the cloud runs.
wandb/

# Eval verification clips: regenerated by any VERIFY_VIDEO=1 run, so they
# churn in the diff and blocked a rebase. The per-episode jsonl next to them is
# the result worth keeping.
vla_augm/results/**/verify_video/

# Rollout videos. Large binaries that git cannot delta-compress and that every
# clone would pay for forever. They live on the cluster (and on a laptop via
# rsync), not in history. vla_augm/results/** is otherwise tracked, so the mp4s are
# excluded by extension rather than by excluding the whole tree -- the reports
# and episode dumps beside them are worth keeping.
vla_augm/results/**/*.mp4
vla_augm/supplementary_videos/

# TensorBoard event files. Written by every run; nothing reads them back for
# eval-only jobs, and they are binary blobs git cannot compress.
events.out.tfevents.*
